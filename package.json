{
  "name": "omp-cmux-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OMP marketplace plugin for complete cmux integration",
  "license": "MIT",
  "author": "usr-bin-roygbiv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usr-bin-roygbiv/omp-cmux.git"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "17.0.7",
    "@types/bun": "^1.2.22",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "plugins/*"
  ],
  "omp": {
    "name": "cmux",
    "version": "0.1.0",
    "description": "Typed cmux tools, raw escape hatches, and lifecycle synchronization.",
    "extensions": [
      "./plugins/cmux/index.ts"
    ],
    "settings": {
      "binary": {
        "type": "string",
        "description": "cmux executable name or path.",
        "default": "cmux",
        "env": "CMUX_OMP_BINARY"
      },
      "tuiBinary": {
        "type": "string",
        "description": "cmux TUI executable name or path.",
        "default": "cmux-tui",
        "env": "CMUX_OMP_TUI_BINARY"
      },
      "timeoutMs": {
        "type": "number",
        "description": "Maximum duration of each cmux child process in milliseconds.",
        "default": 15000,
        "min": 1,
        "env": "CMUX_OMP_TIMEOUT_MS"
      },
      "maxOutputBytes": {
        "type": "number",
        "description": "Maximum captured stdout or stderr bytes per cmux child process.",
        "default": 1048576,
        "min": 1024,
        "env": "CMUX_OMP_MAX_OUTPUT_BYTES"
      }
    }
  }
}
